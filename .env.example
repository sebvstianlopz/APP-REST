# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used by the Stripe webhook to write memberships
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers -> API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
STRIPE_TRIAL_DAYS=30

# Public base URL used for Stripe redirects and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local SQL tests (see scripts/db-reset-local.sh)
TEST_DATABASE_URL=postgres://postgres@localhost:5432/apprest_test
